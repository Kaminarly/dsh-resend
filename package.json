{
  "name": "dsh-resend",
  "version": "0.1.0",
  "description": "Edit-and-resend and regenerate for DeepSeek Harness conversations — a DSH Desktop plugin bundle (skeleton: loads the Host and Client plugins, contributes no behavior yet)",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.bundle.js"
    },
    "./typert-host": {
      "default": "./lib/typert.host.js"
    },
    "./typert-client": {
      "default": "./lib/typert.client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/**/*.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "node scripts/check-syntax.mjs && node scripts/check-typert.mjs --allow-empty-descriptors && node scripts/check-host-contract.mjs",
    "probe": "node scripts/probe-profile.mjs",
    "test": "vitest run"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "deepseek",
    "plugin",
    "edit",
    "resend",
    "regenerate",
    "conversation"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.4",
    "@deepseek-ai/dsh-client-ui-primitives": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "^0.2.0-rc.1",
    "react": "^18.2.0"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "~4.0.4",
    "@deepseek-ai/cordis-plugin-loader": "~1.0.5",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.0-rc.1",
    "@deepseek-ai/dsh-client-ui-slots": "0.2.0-rc.1",
    "@deepseek-ai/dsh-session": "0.2.0-rc.1",
    "@deepseek-ai/dsh-typert-registry": "0.2.0-rc.1",
    "esbuild": "0.28.2",
    "js-yaml": "^4.1.0",
    "node-addon-require-builtin": "^0.1.6",
    "semver": "^7.8.5",
    "vitest": "^4.1.11"
  }
}
